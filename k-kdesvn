#!/usr/bin/env -S deno run -A
// -*- mode: typescript; -*-
/** Commands for managing my local l10n-umbrella repository checkout. */
// vim: ft=typescript

import {
  mkdirSync,
  writeFileSync,
  readdirSync,
  existsSync,
  statSync,
  symlinkSync,
} from "node:fs";
import * as process from "node:process";
import path from "node:path";
import { homedir } from "node:os";

import { Chalk } from "npm:chalk@5.6.2";

import { program } from "npm:@commander-js/extra-typings@14.0.0";

const chalk = new Chalk({
  // Force colors on even if we're piping to another program
  // The main program we're piping to is `less -R`. We just want paging for the
  // same output we'd get in the terminal normally.
  level: 3,
});

import { $, cd } from "npm:zx@8.8.5";

program.description(
  `Commands for managing my local KDE translation repository checkouts.`,
);

/** Return team codes in the umbrella repository. */
function getTeamcodes(): string[] {
  const path = ".";
  if (!existsSync(path)) {
    throw new Error("Unable to read l10n-umbrella directory!");
  }
  if (!statSync(path).isDirectory()) {
    throw new Error("l10n-umbrella is not a directory!");
  }
  const ret: string[] = [];
  for (const dir of readdirSync(path)) {
    if (!dir.startsWith("l10n-")) continue;
    if (dir === "l10n-templates") continue;
    ret.push(dir.replace("l10n-", "").replace("-", "@"));
  }
  return ret;
}

/** Return the dir name of `code` in the umbrella repository. */
function teamcodeToDir(code: string): string {
  return `l10n-${code.replace("@", "-")}`;
}

/**
 * Clone submodules for `languages`, checking that they are all valid.
 * This should be run within the umbrella repository.
 */
async function cloneLanguageSubmodules(languages: string[]) {
  const validLanguages = getTeamcodes();
  const invalidLanguages = [
    ...new Set(languages).difference(new Set(validLanguages)),
  ];
  if (invalidLanguages.length > 0) {
    console.log(
      invalidLanguages.length === 1
        ? `Invalid language code provided: ${invalidLanguages}`
        : `Invalid language codes provided: ${invalidLanguages}`,
    );
    process.exit(1);
  }
  console.log(`Cloning language files...`);
  await $({
    verbose: true,
  })`git submodule update --init --depth 1 ${languages.map(teamcodeToDir)}`;
}

/**
 * Clone the umbrella repository to `dir` then set it up.
 * `readonly`: whether to clone readonly or not
 * `languages`: set the repository up for these languages
 * This should be run in the workspace directory.
 * NOTE: This will manipulate cwd and cannot actually be run in parallel.
 */
async function setupUmbrella(
  dir: string,
  readonly: boolean | undefined,
  languages: string[],
) {
  const pwdBefore = process.cwd();
  const repoUrl = readonly
    ? "https://invent.kde.org/localization/l10n-umbrella.git"
    : "git@invent.kde.org:localization/l10n-umbrella.git";
  console.log(
    readonly
      ? `Cloning the read-only KDE l10n-umbrella repository into ${dir}...`
      : `Cloning the read-write KDE l10n-umbrella repository into ${dir}...`,
  );
  const $$ = $({ verbose: true });
  await $$`git clone --depth=1 ${repoUrl} ${dir}`;
  cd(dir);
  await $$`git submodule update --init --depth 1 l10n-templates`;
  await cloneLanguageSubmodules(languages);
  cd(pwdBefore);
}

/**
 * Set up symlinks for `lang`.
 * Assumes we are in the main dir.
 */
function setupLanguageSymlinks(lang: string) {
  const trunk = lang;
  const stable = `stable.${lang}`;
  mkdirSync(trunk, { recursive: true });
  mkdirSync(stable, { recursive: true });
  // kde-translations/{"","stable."}<lang>/{kf5,kf6}
  // We do {"","stable."}/<lang>/{kf5,kf6} because Lokalize finds files based
  // on the directory hierarchy, and we want to see kf5 and kf6 at once, but
  // we don't want to see trunk and stable at once. Trunk and stable should
  // instead be managed by opening one of them at a time, then using
  // alternative translations to automatically synchronize them over.
  for (const branch of ["5", "6"]) {
    symlinkSync(
      // this is what's written into the symlink, so it's relative to the
      // symlink itself
      path.join("..", "l10n-umbrella", teamcodeToDir(lang), `trunk${branch}`),
      path.join(trunk, `kf${branch}`),
    );
    symlinkSync(
      path.join("..", "l10n-umbrella", teamcodeToDir(lang), `stable${branch}`),
      path.join(stable, `kf${branch}`),
    );
  }
  const termsInKf6 = path.join("kf6", "lokalize-files", "terms.tbx");
  if (existsSync(path.join(trunk, termsInKf6))) {
    symlinkSync(path.join("..", termsInKf6), path.join(trunk, "terms.tbx"));
    symlinkSync(path.join("..", termsInKf6), path.join(stable, "terms.tbx"));
  }
}

/**
 * Create the Lokalize project file for `lang`.
 * Assumes we are in the main dir.
 */
function initLokalizeProject(lang?: string, reference?: string) {
  function promptLoop(message: string) {
    while (true) {
      const answer = prompt(message);
      if (typeof answer === "string") return answer;
      console.log("Please provide an answer");
    }
  }
  const targetLang =
    lang ?? promptLoop("Primary language (for Lokalize project):");
  const referenceLang =
    reference ?? promptLoop(`Reference language for ${targetLang}:`);

  const mailingList =
    targetLang === "zh_TW"
      ? "zh-l10n@lists.slat.org"
      : promptLoop(`Mailing list for ${targetLang}:`);
  const languageName =
    targetLang === "zh_TW"
      ? "Traditional Chinese"
      : promptLoop(`Language name for ${targetLang}:`);

  const trunkAlt = referenceLang;
  const stableAlt = `stable.${referenceLang}`;
  const trunkTarget = targetLang;
  const stableTarget = `stable.${targetLang}`;

  mkdirSync(trunkTarget, { recursive: true });
  writeFileSync(
    path.join(trunkTarget, "index.lokalize"),
    `
[General]
AltDir=../${trunkAlt}
BranchDir=../${stableTarget}
LangCode=${targetLang}
LanguageSource=Project
PotBaseDir=../templates
PotBranchDir=../stable.templates
MailingList=${mailingList}
ProjLangTeam=${languageName} <${mailingList}>
ProjectID=kde-translation-${targetLang}
TargetLangCode=${targetLang}
[RegExps]
Markup=(<[^>]+>)+|(&[A-Za-z_:][A-Za-z0-9_\\\\.:-]*;|%[0-9n])+
`.trim(),
  );
  mkdirSync(stableTarget, { recursive: true });
  writeFileSync(
    path.join(stableTarget, "index.lokalize"),
    `
[General]
AltDir=../${stableAlt}
BranchDir=../${trunkTarget}
LangCode=${targetLang}
LanguageSource=Project
PotBaseDir=../stable.templates
PotBranchDir=../templates
MailingList=${mailingList}
ProjLangTeam=${languageName} <${mailingList}>
ProjectID=kde-translation-${targetLang}
TargetLangCode=${targetLang}
[RegExps]
Markup=(<[^>]+>)+|(&[A-Za-z_:][A-Za-z0-9_\\\\.:-]*;|%[0-9n])+
`.trim(),
  );
}

program
  .command("init")
  .description("Initialize a translation workspace")
  .argument(
    "[dir]",
    "Where to clone to, defaults to 'kde-translations'",
    "kde-translations",
  )
  .option(
    "--langs <languages>",
    "Which languages to clone, as language codes. Comma-separated.",
  )
  .option("--read-only", "whether to clone a read-only repository")
  .action(async (dir: string, opts: { langs?: string; readOnly?: boolean }) => {
    const languages = opts?.langs
      ? opts.langs.split(",").map((x) => x.trim())
      : [];
    if (languages.length < 1) {
      console.log(`Please specify one or more languages with --langs`);
      process.exit(1);
    }
    if (existsSync(dir)) {
      console.log(`${dir} already exists.`);
      process.exit(1);
    }
    // kde-translations/l10n-umbrella, including templates
    await setupUmbrella(
      path.join(dir, "l10n-umbrella"),
      opts.readOnly,
      languages,
    );
    cd(dir);

    console.log("Creating Lokalize project structure...");
    for (const lang of languages) {
      setupLanguageSymlinks(lang);
    }

    console.log("Setting up templates...");
    // kde-translations/{"","stable."}templates/{kf5,kf6}
    mkdirSync("stable.templates");
    // again, these symlink targets are relative to the symlink itself
    symlinkSync(
      path.join("..", "l10n-templates", "stable5"),
      path.join("stable.templates", "kf5"),
    );
    symlinkSync(
      path.join("..", "l10n-templates", "stable6"),
      path.join("stable.templates", "kf6"),
    );
    mkdirSync("templates");
    symlinkSync(
      path.join("..", "l10n-templates", "trunk5"),
      path.join("templates", "kf5"),
    );
    symlinkSync(
      path.join("..", "l10n-templates", "trunk6"),
      path.join("templates", "kf6"),
    );

    console.log("Setting up Lokalize project...");
    initLokalizeProject();

    console.log(`Checkout done.
The Lokalize project can be seen in ${dir}/<language>/index.lokalize.
The filled-in metadata most likely needs updating.
Use ${chalk.yellow("k-kdesvn update")} at ${dir} to pull template and translations.`);
  });

program
  .command("add-language")
  .description("Add a language to the workspace")
  .argument(
    "[dir]",
    "Where the workspace is, defaults to '~/kde-translations'",
    path.join(homedir(), "kde-translations"),
  )
  .option("--lang <language>", "Which language to clone, as a language code.")
  .action(async (dir: string, opts: { lang?: string }) => {
    // only support one since we also need to initialize the project
    if (!opts.lang) {
      console.log(`Please specify the language with --lang`);
      process.exit(1);
    }
    const absDir = path.resolve(dir);
    cd(path.join(absDir, "l10n-umbrella"));
    await cloneLanguageSubmodules([opts.lang]);
    cd(absDir);
    setupLanguageSymlinks(opts.lang);
    initLokalizeProject(opts.lang);
  });

program
  .command("check")
  .description("Do an msgfmt check for all po files")
  .action(async () => {
    const $$ = $({ nothrow: true, verbose: true });
    await $$`fd -e po -x msgfmt -o /dev/null --check-format`;
    await $$`posieve check-tp-kde .`;
  });

program
  .command("update")
  .description(
    `Pull new changes from upstream to the workspace.
This updates the umbrella repository as well as submodules.`,
  )
  .argument(
    "[dir]",
    "Where the workspace is, defaults to '~/kde-translations'",
    path.join(homedir(), "kde-translations"),
  )
  .action(async (dir: string) => {
    const $$ = $({ verbose: true });
    try {
      const abs = path.resolve(dir);
      await $$`cd ${path.join(abs, "l10n-umbrella")} && git pull --recurse-submodules --rebase`;
    } catch (_e) {
      // do nothing, the commands already explain what went wrong
    }
  });

program
  .command("pocount")
  .summary("Show stats of the current folder with pocount.")
  .action(async () => {
    await $({
      nothrow: true,
      verbose: true,
    })`fd -L -e po -X pocount | grep TOTAL -A 8 | grep -v TOTAL`;
  });

program
  .command("log")
  .summary("Like `git log` but exclude commits from scripty.")
  .argument("[path]", "Print log for PATH, defaults to the current directory")
  .action(async (path?: string) => {
    // https://stackoverflow.com/questions/6889830/equivalence-of-git-log-exclude-author
    await $({
      stdio: ["pipe", "inherit", "inherit"],
    })`git log --perl-regexp --author='^(.*(?<!<scripty@kde\\.org>))$' -- ${path}`;
  });

const nan_TW_sub = program
  .command("nan-tw")
  .description("Extra commands for nan_TW");

nan_TW_sub
  .command("fix-plurals")
  .summary("Fix broken default plurals for nan_TW")
  .description(
    `Fix plurals.

This should be run at the root of the translation workspace.

nan_TW should be all-singular, but currently nan_TW files are initiated to
\`nplurals=2; plural=n != 1;\`. This works around it.`,
  )
  .action(async () => {
    await $({
      verbose: true,
    })`find -L nan_TW nan_TW@latin -path '*.po' -execdir sed -i 's/"Plural-Forms: nplurals=2; plural=n != 1;\\\\n"/"Plural-Forms: nplurals=1; plural=0;\\\\n"/' '{}' ';'`;
  });

nan_TW_sub
  .command("sync-glossaries")
  .summary("Synchronize nan_TW and nan_TW@latin glossaries")
  .description(
    `Synchronize nan_TW and nan_TW@latin glossaries.

Lokalize cares about the target language code in a glossary, so when sharing one
glossary with two projects with different language codes (which applies to nan_TW
and nan_TW@latin), the target language code would need to be modified to match.
This automates that.`,
  )
  .action(async () => {
    // The -L makes sure we use the mtime of symlink targets. Because we only
    // read from $newer, it doesn't matter whether sort ends up putting the
    // symlink itself or the symlink target on top since either can be read just fine.
    // (frustratingly, find always lists both with apparently no option to filter
    // out the symlink.)
    //
    // %T@ means "mtime as unix time", %p means file path including starting point
    // sort -n for numeric sort, -r for reversed (larger number first = newer first)
    // head -1 to grab just the first one
    const newer = (
      await $`find -L nan_TW nan_TW@latin -name 'terms.tbx' -printf '%T@ %p\n' | env LC_ALL=C sort -nr | head -1 | cut -d' ' -f2`
    )
      .text()
      .trim();
    if (newer.includes("latin")) {
      const older = "nan_TW/terms.tbx";
      console.log(`Copying ${newer} to ${older}...`);
      await $`sed s/'xml:lang="nan-TW@latin"'/'xml:lang="nan-TW"'/ nan_TW@latin/terms.tbx > $(readlink -f nan_TW/terms.tbx)`;
    } else {
      const older = "nan_TW@latin/terms.tbx";
      console.log(`Copying ${newer} to ${older}...`);
      await $`sed s/'xml:lang="nan-TW"'/'xml:lang="nan-TW@latin"'/ nan_TW/terms.tbx > $(readlink -f nan_TW@latin/terms.tbx)`;
    }
  });

await program.parseAsync();
